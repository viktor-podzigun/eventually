  },
  "keywords": [
    "test",
    "eventually"
  ],
  "engines": {
    "node": ">=16",
    "bun": ">=0.8"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "c8": "^7.14.0",
    "prettier": "^3.8.1",
    "quick-lint-js": "^3.2.0",
    "typescript": "^6.0.3"
  }
